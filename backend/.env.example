# Puerto del servidor backend
PORT=3001

# URL del frontend, usada para generar los QR de ubicaciones.
# Para escanear desde telefonos en la red local, usa la IP del servidor:
# FRONTEND_URL=http://192.168.1.10:5173
FRONTEND_URL=http://localhost:5173

# Clave secreta para firmar los tokens de sesion (JWT).
# IMPORTANTE: cambiala por un valor largo y aleatorio en produccion.
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria
