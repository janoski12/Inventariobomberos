# Puerto del servidor (sirve la app y la API en el mismo puerto)
PORT=3001

# Clave secreta para firmar los tokens de sesion (JWT). OBLIGATORIA:
# el servidor no arranca sin ella. Usa un valor largo y aleatorio en produccion.
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria

# (Opcional) Fuerza el origen usado en los QR de ubicaciones. Normalmente NO
# hace falta: se usa la URL con la que se accede al sistema. Definela solo si
# hay un proxy delante, p.ej.:
# FRONTEND_URL=http://192.168.1.10:3001

# Opcional: recuperacion de contraseña por correo. Sin estas variables el sistema
# funciona igual, pero la pantalla de ingreso no ofrece "¿Olvidaste tu contraseña?".
# Ejemplo con Gmail (requiere verificacion en 2 pasos y una "contraseña de
# aplicacion": cuenta de Google > Seguridad > Contraseñas de aplicaciones):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=correo-del-sistema@gmail.com
# SMTP_PASS=contraseña-de-aplicacion-de-16-letras
# Remitente que se muestra (por defecto: Inventario CBT10 <SMTP_USER>). Sin comillas.
# SMTP_FROM=Inventario CBT10 <correo-del-sistema@gmail.com>
