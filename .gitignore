# Dependencias
node_modules/

# Herramientas de prueba locales (Playwright para verificacion manual, no es parte de la app)
/package.json
/package-lock.json

# Base de datos (datos locales, no versionar)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/backups/
backend/data/documentos/

# Env
.env
.env.local

# Firma del Capitán: se timbra en las actas (ver FIRMA_CAPITAN_PATH en
# backend/lib/documentos.js), pero no debe vivir en un repo público. Se
# coloca a mano en cada checkout/servidor, igual que el .env; sin el
# archivo, el sistema sigue funcionando y solo omite el timbre.
backend/assets/firma_capitan.png

# Build
dist/

# OS
.DS_Store
Thumbs.db
