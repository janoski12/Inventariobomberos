# Copia este archivo a ".env" (en la misma carpeta que docker-compose.yml)
# antes de "docker compose up".

# Clave secreta para firmar los tokens de sesion. OBLIGATORIA.
# Genera una propia con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria

# Opcional: fuerza el origen usado en los QR de ubicaciones/carros.
# Normalmente NO hace falta (se usa la URL con la que se accede al sistema).
# FRONTEND_URL=http://192.168.1.10:3001
